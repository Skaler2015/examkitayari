# ==========================================================================
# ExamsKiTayari.com — Environment Variables (example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Core ---
NODE_ENV=development
# Public base URL of the site (used for SEO, sitemaps, canonical URLs, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ExamsKiTayari

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# On Neon/Vercel, use the POOLED connection string here (host contains "-pooler").
DATABASE_URL=postgresql://examskitayari:examskitayari@localhost:5432/examskitayari?schema=public
# Direct (non-pooled) connection used ONLY for migrations. On Neon use the
# NON-pooled URL. For local/Docker set it to the SAME value as DATABASE_URL.
DIRECT_URL=postgresql://examskitayari:examskitayari@localhost:5432/examskitayari?schema=public

# --- Redis (cache + queue). Optional in dev: the app falls back to in-memory. ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Long random string used to sign session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-value
# Session lifetime in seconds (default 7 days)
AUTH_SESSION_TTL=604800

# --- Seed / bootstrap admin (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@examskitayari.com
SEED_ADMIN_PASSWORD=ChangeMe#12345
SEED_ADMIN_NAME=Platform Admin

# --- AI provider (server-side only — NEVER expose to the browser) ---
# Provider-agnostic. Supported: "anthropic", "openai", "disabled".
AI_PROVIDER=disabled
AI_API_KEY=
# Model id for the chosen provider.
#   Anthropic: claude-sonnet-5 (quality) or claude-haiku-4-5-20251001 (cheaper)
#   OpenAI:    gpt-4o or gpt-4o-mini
AI_MODEL=claude-sonnet-5
# Max tokens per generation
AI_MAX_TOKENS=2048

# --- Object storage (S3-compatible). Optional in dev: falls back to local disk. ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=examskitayari
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Crawler / Source Monitoring Engine ---
# User-agent used for all outbound source requests. MUST identify the crawler.
CRAWLER_USER_AGENT=ExamsKiTayariBot/1.0 (+https://examskitayari.com/bot)
# Default polite delay between requests to the same host (ms)
CRAWLER_DEFAULT_DELAY_MS=2000
# Max concurrent source fetches
CRAWLER_MAX_CONCURRENCY=4
# Global request timeout (ms)
CRAWLER_TIMEOUT_MS=30000
# Respect robots.txt (true/false)
CRAWLER_RESPECT_ROBOTS=true

# --- Optional scraping proxy (for JS-rendered / bot-protected sites) ---
# Many government portals return 403 to bots or render content via JavaScript.
# When a provider is set, HTML/RSS/sitemap fetches route through it (renders JS,
# rotates IPs). Leave as "none" to fetch directly. Keys are server-side only.
# Providers: none | scraperapi | scrapingbee | custom
SCRAPER_PROVIDER=none
SCRAPER_API_KEY=
# Render JavaScript (needed for SPA/JS-heavy sites; uses more credits)
SCRAPER_RENDER_JS=true
# For SCRAPER_PROVIDER=custom: a URL template with {key} and {url} placeholders
SCRAPER_URL_TEMPLATE=
# Timeout for proxied requests (JS rendering is slow), ms
SCRAPER_TIMEOUT_MS=70000

# --- Worker / Scheduler ---
# Master switch for background automation. If false, no crawls run automatically.
AUTOMATION_ENABLED=true
# How often (seconds) the scheduler wakes up to dispatch due sources.
SCHEDULER_TICK_SECONDS=60
# Bearer token accepted by POST /api/cron/tick (serverless automation driver).
# On Vercel, set CRON_SECRET and Vercel Cron sends it automatically. External
# cron (cron-job.org / GitHub Actions) can use CRON_SECRET or AUTH_SECRET.
CRON_SECRET=
# One-time token for GET/POST /api/setup (runs idempotent DB seed on first deploy).
SETUP_TOKEN=change-me-one-time-setup-token

# --- Email (notifications). Optional. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ExamsKiTayari <no-reply@examskitayari.com>

# --- Web Push (VAPID). Optional. Generate with your push library. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Logging ---
LOG_LEVEL=info
