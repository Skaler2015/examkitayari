  "private": true,
  "description": "ExamsKiTayari.com — Indian competitive-exam preparation and exam-update platform with a configurable Official Source Monitoring Engine.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
